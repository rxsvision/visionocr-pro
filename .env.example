# VisionOCR Pro 环境变量配置
# 复制此文件为 .env 并填入实际值: cp .env.example .env
# config.yaml 中通过 ${VAR_NAME:-default} 引用这些变量

# ─── LLM / AI ─────────────────────────────────────────────────
# 云端 LLM API Key (DeepSeek / OpenAI 兼容接口)
VISIONOCR_API_KEY=

# HuggingFace 镜像 (国内加速, 留空则直连)
# HF_ENDPOINT=https://hf-mirror.com

# ─── 相机 SDK 路径 ────────────────────────────────────────────
# 海康 MVS SDK (默认: C:\Program Files (x86)\MVS\Development\Bin\Win64_x64)
HIK_SDK_PATH=C:\Program Files (x86)\MVS\Development\Bin\Win64_x64

# Sizector 3D 结构光 SDK (.NET wrapper 目录, 含 MPSizectorS_DotNet.dll)
SIZECTOR_SDK_DIR=

# ─── ERP 连接器 (可选) ────────────────────────────────────────
# 用友 U8/YonBIP
YONYOU_BASE_URL=
YONYOU_APP_KEY=
YONYOU_APP_SECRET=

# 金蝶 K3Cloud
KINGDEE_BASE_URL=
KINGDEE_ACCT_ID=
KINGDEE_USERNAME=
KINGDEE_PASSWORD=

# ─── 通知 (可选) ──────────────────────────────────────────────
# 飞书机器人 Webhook
FEISHU_WEBHOOK=
# 企业微信机器人 Webhook
WECOM_WEBHOOK=

# ─── 条码识别 (可选) ──────────────────────────────────────────
# Dynamsoft Barcode Reader 许可证
DYNAMSOFT_LICENSE=
