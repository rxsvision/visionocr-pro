# VisionOCR Pro - PaddleOCR 子服务 (PP-OCRv6)
#
# 用途: 在 Windows 上通过容器运行 PaddleOCR PP-OCRv6 (绕过原生 cudnn DLL 冲突)
# 构建: docker build -f docker/Dockerfile.paddleocr -t visionocr-paddleocr .
# 运行 (GPU): docker run --gpus all -v "D:\images:/data" visionocr-paddleocr /data/test.png
# 运行 (CPU): docker run --rm -v "D:\images:/data" visionocr-paddleocr /data/test.png --device cpu
#
# 输出: JSON 到 stdout, 格式与 _paddle_worker.py 一致
#   {"text": "...", "lines": [...], "confidence": 0.95, "engine": "paddleocr_vl"}
#
# 精度基准 (60张工业合成图, CPU):
#   PP-OCRv6: 93.3% exact match, CER 0.021, 117ms/img
#   RapidOCR: 56.7% exact match, CER 0.332, 927ms/img

FROM paddlepaddle/paddle:3.3.1-gpu-cuda12.6-cudnn9.5

ENV DEBIAN_FRONTEND=noninteractive

# 安装 PaddleOCR 3.7+ (含 PP-OCRv6 模型)
RUN pip install --no-cache-dir "paddleocr>=3.7" --quiet

# 复制 worker 脚本
COPY engines/ocr/_paddle_worker.py /app/worker.py

WORKDIR /app

# PIR/OneDNN 兼容性标志 (CPU 推理必需)
ENV FLAGS_enable_pir_api=0
ENV FLAGS_enable_pir_in_executor=0
ENV FLAGS_use_mkldnn=0
ENV GLOG_minloglevel=2
ENV FLAGS_minloglevel=2
ENV PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# 入口: python worker.py <image_path> [--device gpu|cpu]
ENTRYPOINT ["python", "worker.py"]
CMD ["--help"]
